// ============================================================================
// TaianDotFilesNiri — niri config entrypoint
// Equivalent to hyprland.lua: only loads the modules under TaianNiriM/
// ============================================================================
// Minimum versions used by this config:
//   - include (top level):        niri >= 25.11
//   - blur {} / background-effect: niri >= 26.04
//   - layer-rule:                  niri >= 25.01
//
// Notes on `include`:
//   - Only works at the top level of the config (never inside a section).
//   - Includes are POSITIONAL: they override what was defined before.
//   - `binds` are merged across files; a repeated bind is overridden.
//   - Multipart sections (window-rule, layer-rule, output, workspace)
//     are inserted as-is at the include point.
//   - struts, preset-column-widths, animations subsections and input devices
//     are NOT merged across includes.

include "TaianNiriM/env.kdl"
include "TaianNiriM/autostart.kdl"
include "TaianNiriM/keybinds.kdl"
include "TaianNiriM/general.kdl"
include "TaianNiriM/monitors.kdl"
include "TaianNiriM/rules.kdl"
include "TaianNiriM/input.kdl"
include "TaianNiriM/gestures.kdl"
include "TaianNiriM/animations.kdl"

// Colors generated by matugen (overview/backdrop, background and borders).
// `optional=true` avoids failure if the file has not been generated yet.
include optional=true "~/.config/niri/colors.kdl"
