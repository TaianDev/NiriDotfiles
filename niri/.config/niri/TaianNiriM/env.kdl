// ============================================================================
// Theme & Appearance (Cursors, GTK, and Qt styling)
// ============================================================================
// Equivalent to env.lua (hl.env). In niri, compositor environment variables
// are declared in the top-level `environment {}` section.
environment {
    XCURSOR_THEME "Sunset-cursors"
    XCURSOR_SIZE "20"
    GTK_THEME "adw-gtk3-dark"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"

    // ========================================================================
    // Hardware Acceleration & Graphics Drivers
    // ========================================================================
    LIBVA_DRIVER_NAME "iHD"

    // ========================================================================
    // Wayland & Toolkit Backends
    // ========================================================================
    // NOTE: GDK_BACKEND is intentionally NOT set globally. The niri wiki warns
    // that forcing it breaks the screencast portal (xdg-desktop-portal-gnome).
    QT_QPA_PLATFORM "wayland;xcb"
    SDL_VIDEODRIVER "wayland"
    CLUTTER_BACKEND "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    MOZ_ENABLE_WAYLAND "1"
    QT_WAYLAND_RECONNECT "1"

    // ========================================================================
    // Desktop Environment & System Integration
    // ========================================================================
    // Kept while this config is still being edited from Arch.
    XDG_MENU_PREFIX "arch-"
}

// ============================================================================
// Cursor
// ============================================================================
// Replaces `hyprctl setcursor Sunset-cursors 24` from the Hyprland autostart.
// The cursor theme is installed separately (not managed by stow).
cursor {
    xcursor-theme "Sunset-cursors"
    xcursor-size 24
}
