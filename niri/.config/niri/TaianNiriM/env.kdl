// ============================================================================
// Theme & Appearance (Cursors, GTK, and Qt styling)
// ============================================================================
// Equivalent to env.lua (hl.env). In niri, compositor environment variables
// are declared in the top-level `environment {}` section.
environment {
// GTK & Qt Themes
    GTK_THEME "adw-gtk3-dark"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"

    // Wayland & Toolkit Backends
    QT_QPA_PLATFORM "wayland;xcb"
    QT_WAYLAND_RECONNECT "1"
    SDL_VIDEODRIVER "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"

    // Hardware Acceleration (Conservar solo si tu procesador es Intel)
    LIBVA_DRIVER_NAME "iHD"
}

// ============================================================================
// Cursor
// ============================================================================
// Replaces `hyprctl setcursor Sunset-cursors 24` from the Hyprland autostart.
// The cursor theme is installed separately (not managed by stow).
cursor {
    xcursor-theme "Breeze_Light"
    xcursor-size 28
}
