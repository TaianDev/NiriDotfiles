// ============================================================================
// niri Animations
// ============================================================================
// Equivalent to animations.lua. Hyprland and niri use different models:
//   - niri uses springs or easing (ease-out-*, linear, cubic-bezier).
//   - There are NO "styles" (slide bottom, slidevert) or per-layer animations.
//   - `custom-shader` allows custom animations (no cross-version guarantee).
//
// Hyprland bezier curves translated to cubic-bezier:
//   overshot   (0.05, 0.9, 0.1, 1.03)
//   md3_decel  (0.05, 0.7, 0.1, 1)
//   md3_accel  (0.3, 0, 0.8, 0.15)
//   menu_decel (0.1, 1, 0, 1)
//   menu_accel (0.38, 0.04, 1, 0.07)

animations {
    // windowsIn -> overshot
    window-open {
        duration-ms 250
        curve "cubic-bezier" 0.05 0.9 0.1 1.03
    }

    // windowsOut -> md3_accel
    window-close {
        duration-ms 200
        curve "cubic-bezier" 0.3 0.0 0.8 0.15
    }

    // workspaces -> slide with a slight bounce (spring)
    // Note: workspace switching in niri is VERTICAL, not horizontal.
    workspace-switch {
        spring damping-ratio=0.9 stiffness=800 epsilon=0.0001
    }

    // Horizontal view movement (scrolling between columns)
    horizontal-view-movement {
        spring damping-ratio=0.9 stiffness=800 epsilon=0.0001
    }

    // window-movement / window-resize
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // specialWorkspace -> overview
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // screenshot UI (equivalent to the default screenshot-ui-open)
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    // fade / layersIn / layersOut / border have no direct equivalent in niri;
    // they are intentionally omitted.
}
