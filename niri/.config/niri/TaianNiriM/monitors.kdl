// ============================================================================
// Display & Monitor Layout Configuration
// ============================================================================
// Equivalent to monitors.lua (hl.monitor).
//
// IMPORTANT: niri requires the refresh rate to match EXACTLY (3 decimals) what
// `niri msg outputs` reports. If the mode does not match, niri will pick one
// automatically. Check the real values with: niri msg outputs

// Main Monitor (HDMI-A-1): 1080p @ 144Hz on the left (0x0)
// The refresh rate must match `niri msg outputs` EXACTLY (3 decimals).
output "HDMI-A-1" {
    mode "1920x1080@143.981"
    position x=0 y=0
    scale 1
    focus-at-startup
}

// Secondary Laptop Screen (eDP-1): 768p @ 60Hz on the right (1920x0)
output "eDP-1" {
    mode "1366x768@60.004"
    position x=1920 y=0
    scale 1
}
