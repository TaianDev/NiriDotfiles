{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "source": "fedora",
        "padding": {
            "top": 1,
            "left": 1,
            "right": 1
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[37m╔══════════════════════════System════════════════════════╗"
        },
        {
            "type": "title",
            "key": " ╭  ",
            "format": "{user-name}@{host-name}",
            "keyColor": "36"
        },
        {
            "type": "os",
            "key": " ├ OS",
            "keyColor": "1"
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "1"
        },
        {
            "type": "command",
            "key": " ├ 󰏖  OS Age",
            "keyColor": "32",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); Days_difference=$((time_progression / 86400)); echo $Days_difference Days"
        },
        {
            "type": "uptime",
            "key": " ├ 󰅐 ",
            "keyColor": "32"
        },
        {
            "type": "wm",
            "key": " ├ WM",
            "keyColor": "1"
        },
        {
            "type": "packages",
            "format": "{} (packages installed)",
            "key": " ├ 󰏖 ",
            "keyColor": "1"
        },
        {
            "type": "shell",
            "key": " ├  ",
            "keyColor": "1"
        },
        {
            "type": "terminal",
            "key": " └  ",
            "keyColor": "1"
        },
        {
            "type": "custom",
            "format": "\u001b[37m╚════════════════════════════════════════════════════════╝"
        },
        {
            "type": "custom",
            "format": "                     \u001b[90m●  \u001b[37m●  \u001b[32m●  \u001b[33m●  \u001b[34m●  \u001b[35m●  \u001b[36m●  \u001b[37m● "
        },
        {
            "type": "custom",
            "format": "\u001b[37m╔════════════════════════Hardware════════════════════════╗"
        },
        {
            "type": "host",
            "format": "{5} {1} Type {2}",
            "key": " ╭ 󰌢 ",
            "keyColor": "36"
        },
        {
            "type": "cpu",
            "key": " ├  ",
            "keyColor": "36",
            "showPeCoreCount": true,
            "temp": true,
            "format": "{name} C:{core-types} {freq-max}"
        },
        {
            "type": "gpu",
            "key": " ├ 󰢮 ",
            "keyColor": "36",
            "detectionMethod": "auto",
            "driverSpecific": true,
            "format": "{name} C:{core-count}{?frequency} {frequency}{?}"
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "36",
            "percent": {
                "type": 2,
                "green": 30,
                "yellow": 70,
                "red": 90
            }
        },
        {
            "type": "disk",
            "key": " ├ 󰋊 ",
            "keyColor": "36",
            "percent": {
                "type": 2,
                "green": 30,
                "yellow": 70,
                "red": 90
            }
        },
        {
            "type": "swap",
            "key": " └ 󰓡 ",
            "keyColor": "36",
            "percent": {
                "type": 2,
                "green": 30,
                "yellow": 70,
                "red": 90
            }
        },
        {
            "type": "custom",
            "format": "\u001b[37m╚════════════════════════════════════════════════════════╝"
        },
        {
            "type": "custom",
            "format": "                     \u001b[90m●  \u001b[37m●  \u001b[32m●  \u001b[33m●  \u001b[34m●  \u001b[35m●  \u001b[36m●  \u001b[37m● "
        }
    ]
}
